---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{titulo}</title>
        <meta
            name="description"
            content="Juego educativo interactivo para aprender las vocales."
        />
    </head>

    <body>
        <main class="pagina">
            <div
                style="position: relative; width: 100%; height: 0; padding-top: 100.0000%;
 padding-bottom: 0; box-shadow: 0 2px 8px 0 rgba(63,69,81,0.16); margin-top: 1.6em; margin-bottom: 0.9em; overflow: hidden;
 border-radius: 8px; will-change: transform;"
            >
                <iframe
                    loading="lazy"
                    style="position: absolute; width: 100%; height: 100%; top: 0; left: 0; border: none; padding: 0;margin: 0;"
                    src="https://www.canva.com/design/DAHX1efwKkc/fcXA1n4xrFWv5uvUkSrW-g/view?embed"
                    allowfullscreen="allowfullscreen"
                    allow="fullscreen"
                >
                </iframe>
            </div>
            <a
                href="https://www.canva.com/design/DAHX1efwKkc/fcXA1n4xrFWv5uvUkSrW-g/view?utm_content=DAHX1efwKkc&utm_campaign=designshare&utm_medium=embeds&utm_source=link"
                target="_blank"
                rel="noopener">Actividad digital de vocales</a
            > de Papeleria Arcoíris
        </main>
    </body>
</html>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #fff8e8;
    }

    .pagina {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 30px 20px;
        text-align: center;
    }

    h1 {
        color: #7b4bb7;
        font-size: clamp(1.6rem, 4vw, 2.5rem);
        margin-bottom: 12px;
    }

    .descripcion {
        color: #555;
        font-size: 1.1rem;
        margin-bottom: 28px;
    }

    .container-wrapper-genially {
        position: relative;
        width: 100%;
        min-height: 400px;
        overflow: hidden;
        border-radius: 18px;
    }

    .genially-embed {
        position: relative;
        width: 100%;
        min-height: 400px;
        margin: 0 auto;
    }
</style>
