
---
const titulo = "Mi juego educativo de las vocales";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titulo}</title>
    <meta
      name="description"
      content="Juego educativo interactivo para aprender las vocales."
    />
  </head>

  <body>
    <main class="pagina">
      <h1>🐸 ¡Vamos a jugar con las vocales!</h1>
      <p class="descripcion">
        Diviértete aprendiendo con nuestro juego interactivo.
      </p>

      <!-- Juego de Genially -->
      <div class="container-wrapper-genially">
        <div
          id="6acc53bd2deb6bd5811aa9fd"
          class="genially-embed"
        ></div>
      </div>
    </main>

    <!-- Script de Genially -->
    <script>
      const id = "genially-embed-js";

      if (!document.getElementById(id)) {
        const js = document.createElement("script");
        js.id = id;
        js.async = true;
        js.src =
          "https://view.genially.com/static/embed/embed.js";

        document.body.appendChild(js);
      }
    </script>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: #fff8e8;
  }

  .pagina {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 30px 20px;
    text-align: center;
  }

  h1 {
    color: #7b4bb7;
    font-size: clamp(1.6rem, 4vw, 2.5rem);
    margin-bottom: 12px;
  }

  .descripcion {
    color: #555;
    font-size: 1.1rem;
    margin-bottom: 28px;
  }

  .container-wrapper-genially {
    position: relative;
    width: 100%;
    min-height: 400px;
    overflow: hidden;
    border-radius: 18px;
  }

  .genially-embed {
    position: relative;
    width: 100%;
    min-height: 400px;
    margin: 0 auto;
  }
</style>
