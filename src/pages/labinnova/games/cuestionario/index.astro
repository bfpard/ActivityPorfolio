---
import Layout from "../../../../layouts/Layout.astro";
import headerNavigation from "../../../../data/json/headerinnova.json";
---

<Layout headerNavigation={headerNavigation}>
    <style>
        .encuesta-section {
            max-width: 1200px;
            margin: 3rem auto;
            padding: 2rem;
        }

        .encuesta-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .encuesta-header h2 {
            color: #4f46e5;
            font-size: 2rem;
            margin-bottom: 0.5rem;
        }

        .encuesta-header p {
            color: #64748b;
            font-size: 1rem;
        }

        .form-container {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .form-container iframe {
            display: block;
            width: 100%;
            border: none;
        }
        .google-form-card {
            background: linear-gradient(135deg, #f8faff, #eef5ff);
            border-radius: 24px;
            padding: 1.5rem;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
        }

        .card-title {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 1rem;
        }

        .card-title span {
            font-size: 2rem;
        }

        .card-title h2 {
            margin: 0;
            color: #2563eb;
        }

        .google-form-card iframe {
            width: 100%;
            min-height: 1200px;
            border: none;
            border-radius: 16px;
            background: white;
        }
    </style>
    <section class="encuesta-section">
        <div class="encuesta-header">
            <h2>📝 Evaluación de la Actividad</h2>
            <p>
                Completa el siguiente formulario para registrar tu participación
                y compartir tu experiencia.
            </p>
        </div>

        <div class="form-container">
            <iframe
                src="https://docs.google.com/forms/d/e/1FAIpQLSfPoU2oXZORj7-rPmKKRv78t-9QpGUdNj6foHBhR7BFeq2lsQ/viewform?embedded=true"
                width="100%"
                height="1200"
                frameborder="0"
                marginheight="0"
                marginwidth="0"
                loading="lazy"
            >
                Cargando formulario...
            </iframe>
        </div>
    </section>
</Layout>
