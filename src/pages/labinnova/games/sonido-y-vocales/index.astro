  </div>
  <script>
(() => {
const $=id=>document.getElementById(id), vowels=['A','E','I','O','U'];
const items=[{v:'A',name:'Árbol',emoji:'🌳'},{v:'E',name:'Elefante',emoji:'🐘'},{v:'I',name:'Iguana',emoji:'🦎'},{v:'O',name:'Oso',emoji:'🐻'},{v:'U',name:'Uva',emoji:'🍇'}];
let muted=false,utterance=null,audioCtx=null,story=0,page=0,songActive=-1,repeats=[false,false];
function stop(){if('speechSynthesis'in window) speechSynthesis.cancel();utterance=null;songActive=-1}
function say(text,done){if(muted||!('speechSynthesis'in window))return;stop();utterance=new SpeechSynthesisUtterance(text);utterance.lang='es-CO';utterance.rate=.78;utterance.pitch=1.1;utterance.onend=()=>{utterance=null;if(done)done()};speechSynthesis.speak(utterance)}
function tone(freq=540){if(muted)return;try{audioCtx ||= new (window.AudioContext||window.webkitAudioContext)();audioCtx.resume();let o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type='sine';o.frequency.value=freq;g.gain.setValueAtTime(.001,audioCtx.currentTime);g.gain.exponentialRampToValueAtTime(.07,audioCtx.currentTime+.02);g.gain.exponentialRampToValueAtTime(.001,audioCtx.currentTime+.23);o.connect(g).connect(audioCtx.destination);o.start();o.stop(audioCtx.currentTime+.24)}catch(e){}}
function forest(){tone(600);setTimeout(()=>{if(!muted&&$('sounds').hidden===false)tone(790)},190)}
function show(id){stop();document.querySelectorAll('.view').forEach(v=>v.hidden=v.id!==id);if(id==='listen')renderListen();if(id==='match')renderMatch();if(id==='order')renderOrder();if(id==='quiz')renderQuiz();if(id==='sounds')renderSounds();window.scrollTo(0,0)}
document.querySelectorAll('[data-go]').forEach(b=>b.addEventListener('click',()=>show(b.dataset.go)));
$('mute').addEventListener('click',()=>{muted=!muted;if(muted)stop();$('mute').setAttribute('aria-pressed',String(muted));$('mute').setAttribute('aria-label',muted?'Activar sonidos':'Silenciar sonidos');document.querySelector('[data-template-id="mute-label"]').hidden=muted;document.querySelector('[data-template-id="unmute-label"]').hidden=!muted});
const storyTitles=['Las vocales viajeras','La ronda de las vocales','El bosque de las palabras'];
const storyQA=[
[{q:'¿Qué buscaban las vocales?',opts:['Cinco notas','Un tren'],answer:0},{q:'¿Dónde cantaron juntas?',opts:['En el bosque','En el mar'],answer:0}],
[{q:'¿Qué formaron las amigas?',opts:['Una ronda','Una torre'],answer:0},{q:'¿Qué hicieron para incluir a otra amiga?',opts:['Abrieron espacio','Se fueron'],answer:0}],
[{q:'¿Dónde leyó Ana?',opts:['Junto a un árbol','En una nave'],answer:0},{q:'¿Qué sembraron juntos?',opts:['Una semilla','Un zapato'],answer:0}]
];
let storyAnswers=[];
function openStory(n){story=n;page=0;storyAnswers=[];show('reader');renderStory()}
document.querySelectorAll('[data-story]').forEach(b=>b.addEventListener('click',()=>openStory(Number(b.dataset.story))));
function pages(){return [...$('story-'+story).querySelectorAll('.story-page')]}
function renderStory(){document.querySelectorAll('.story-pages').forEach((s,i)=>s.hidden=i!==story);$('reader-heading').textContent=storyTitles[story];let list=pages(),ended=page===list.length;list.forEach((s,i)=>s.hidden=ended||i!==page);$('reader-end').hidden=!ended;$('reader-progress').textContent=ended?'Preguntas del cuento':`Escena ${page+1} de ${list.length}`;$('reader-prev').disabled=page===0;$('reader-next').hidden=ended;$('reader-play').disabled=ended;if(ended)renderStoryQuestions()}
function renderStoryQuestions(){let box=$('story-questions');box.replaceChildren();storyQA[story].forEach((q,i)=>{let section=document.createElement('div');section.className='mb-5';let title=document.createElement('p');title.className='font-bold';title.textContent=`${i+1}. ${q.q}`;section.append(title);let options=document.createElement('div');options.className='flex flex-wrap gap-3';q.opts.forEach((label,j)=>{let b=document.createElement('button');b.type='button';b.className='pill secondary';b.textContent=label;b.disabled=storyAnswers[i]!==undefined;b.addEventListener('click',()=>{if(storyAnswers[i]!==undefined)return;if(j!==q.answer){$('story-result').textContent='Casi. Prueba otra respuesta.';tone(320);return}storyAnswers[i]=j;tone(800);$('story-result').textContent=storyAnswers.filter(x=>x!==undefined).length===2?'¡Muy bien! Recordaste el cuento.':'¡Muy bien! Ahora responde la otra pregunta.';renderStoryQuestions()});options.append(b)});section.append(options);box.append(section)})}
$('reader-prev').addEventListener('click',()=>{stop();page=Math.max(0,page-1);renderStory()});$('reader-next').addEventListener('click',()=>{stop();page=Math.min(pages().length,page+1);renderStory()});
$('reader-play').addEventListener('click',()=>{if(muted)return;if(speechSynthesis.paused&&utterance){speechSynthesis.resume();return}let s=pages()[page];if(s)say(s.querySelector('h3').textContent+'. '+s.querySelector('p').textContent)});
$('reader-pause').addEventListener('click',()=>{if('speechSynthesis'in window&&speechSynthesis.speaking)speechSynthesis.pause()});
$('reader-restart').addEventListener('click',()=>{stop();page=0;storyAnswers=[];$('story-result').textContent='';renderStory()});
const songText=['A abre los brazos al sol. E estira el cuerpo mejor. I salta, O gira al pasar. U da una vuelta al cantar. A, E, I, O, U. Cinco amigas, ven tú.','A ve un árbol despertar. E oye al elefante hablar. I mira a la iguana ir. O ve al oso sonreír. U encuentra una uva azul. Demos palmas, una y dos.'];
function playSong(n){if(muted)return;say(songText[n],()=>{if(repeats[n]&&songActive===n&&!muted)playSong(n)});songActive=n}
document.querySelectorAll('.song-play').forEach(b=>b.addEventListener('click',()=>{let n=+b.dataset.song;if(songActive===n&&speechSynthesis.paused){speechSynthesis.resume();return}playSong(n)}));
document.querySelectorAll('.song-pause').forEach(b=>b.addEventListener('click',()=>{if(songActive===+b.dataset.song&&speechSynthesis.speaking)speechSynthesis.pause()}));
document.querySelectorAll('.song-repeat').forEach(b=>b.addEventListener('click',()=>{let n=+b.dataset.song;repeats[n]=!repeats[n];b.setAttribute('aria-pressed',String(repeats[n]));b.textContent=repeats[n]?'↺ Repetir: sí':'↺ Repetir: no'}));
let soundIndex=0,soundScore=0,soundDone=false;
const soundRounds=[{v:'A',sound:'A',options:['A','E','O']},{v:'E',sound:'Elefante',options:['Elefante','Oso','Iguana']},{v:'I',sound:'Iguana',options:['Uva','Iguana','Árbol']},{v:'O',sound:'Oso',options:['Oso','Elefante','Uva']},{v:'U',sound:'Uva',options:['Iguana','Árbol','Uva']},{v:'A',sound:'Árbol',options:['Árbol','Oso','Elefante']}];
function renderSounds(){$('sounds-count').textContent=`Aciertos: ${soundScore} de ${soundRounds.length} · Turno ${Math.min(soundIndex+1,soundRounds.length)} de ${soundRounds.length}`;$('sounds-options').replaceChildren();$('sounds-next').hidden=!soundDone||soundIndex>=soundRounds.length;$('sounds-play').hidden=soundIndex>=soundRounds.length;if(soundIndex>=soundRounds.length){$('sounds-feedback').textContent=`¡Terminaste! Acertaste ${soundScore} de ${soundRounds.length}.`;return}let round=soundRounds[soundIndex];round.options.forEach(option=>{let b=document.createElement('button');b.type='button';b.className='choice object-choice';b.textContent=(items.find(i=>i.name===option)?.emoji||'🔤')+' '+option;b.disabled=soundDone;b.addEventListener('click',()=>{if(soundDone)return;if(option===round.sound){soundDone=true;soundScore++;tone(780);$('sounds-feedback').textContent='¡Muy bien! Reconociste el sonido.';renderSounds();$('sounds-next').hidden=false}else{b.classList.add('wrong');tone(330);$('sounds-feedback').textContent='Casi. Escucha otra vez e inténtalo.'}});$('sounds-options').append(b)})}
$('sounds-play').addEventListener('click',()=>{if(soundIndex<soundRounds.length){forest();setTimeout(()=>{if(!$('sounds').hidden)say(soundRounds[soundIndex].sound)},330)}});
$('sounds-next').addEventListener('click',()=>{soundIndex++;soundDone=false;$('sounds-feedback').textContent='';renderSounds()});$('sounds-reset').addEventListener('click',()=>{soundIndex=0;soundScore=0;soundDone=false;$('sounds-feedback').textContent='';renderSounds()});
let selectedImage=null,classified=new Set();
function renderGallery(){$('classify-count').textContent=`Aciertos: ${classified.size} de 5`;document.querySelectorAll('[data-gallery]').forEach(b=>{let i=+b.dataset.gallery;b.classList.toggle('selected',selectedImage===i);b.disabled=classified.has(i);b.setAttribute('aria-pressed',String(selectedImage===i))});$('classify-vowels').replaceChildren();vowels.forEach(v=>{let b=document.createElement('button');b.type='button';b.className='choice';b.textContent=v;b.addEventListener('click',()=>{if(selectedImage===null){$('classify-feedback').textContent='Primero toca una imagen.';return}let item=items[selectedImage];if(item.v===v){classified.add(selectedImage);tone(800);$('classify-feedback').textContent=classified.size===5?'¡Clasificaste todas las imágenes!':`¡Sí! ${item.name} comienza con ${v}.`;selectedImage=null;renderGallery()}else{tone(330);$('classify-feedback').textContent='Casi. Escucha la palabra y prueba otra vocal.'}});$('classify-vowels').append(b)})}
document.querySelectorAll('[data-gallery]').forEach(b=>b.addEventListener('click',()=>{selectedImage=+b.dataset.gallery;let item=items[selectedImage];$('gallery-name').replaceChildren();let letter=document.createElement('span');letter.className='initial';letter.textContent=item.name[0];$('gallery-name').append(letter,document.createTextNode(item.name.slice(1)+' · Vocal inicial: '+item.v));$('classify-feedback').textContent=`Ahora toca la vocal de ${item.name}.`;say(item.name+'. Comienza con '+item.v);renderGallery()}));
$('classify-reset').addEventListener('click',()=>{classified.clear();selectedImage=null;$('gallery-name').textContent='';$('classify-feedback').textContent='';renderGallery()});renderGallery();
let listenIndex=0,listenScore=0,listenDone=false;
function renderListen(){$('listen-count').textContent=`Aciertos: ${listenScore} de 5 · Vocal ${Math.min(listenIndex+1,5)} de 5`;$('listen-options').replaceChildren();$('listen-play').hidden=listenIndex>=5;$('listen-next').hidden=!listenDone||listenIndex>=5;if(listenIndex>=5){$('listen-feedback').textContent=`¡Terminaste! Acertaste ${listenScore} de 5.`;return}let correct=vowels[listenIndex];[correct,...vowels.filter(v=>v!==correct).slice(0,2)].sort((a,b)=>vowels.indexOf(b)-vowels.indexOf(a)).forEach(v=>{let b=document.createElement('button');b.type='button';b.className='choice';b.textContent=v;b.disabled=listenDone;b.addEventListener('click',()=>{if(v===correct){listenDone=true;listenScore++;tone(780);$('listen-feedback').textContent='¡Muy bien! Esa es la vocal '+v+'.';renderListen();$('listen-next').hidden=false}else{b.classList.add('wrong');tone(330);$('listen-feedback').textContent='Casi. Escucha otra vez.'}});$('listen-options').append(b)})}
$('listen-play').addEventListener('click',()=>say(vowels[listenIndex]+'. '+vowels[listenIndex]));$('listen-next').addEventListener('click',()=>{listenIndex++;listenDone=false;$('listen-feedback').textContent='';renderListen()});$('listen-reset').addEventListener('click',()=>{listenIndex=0;listenScore=0;listenDone=false;$('listen-feedback').textContent='';renderListen()});
let chosen=null,matched=new Set();
function renderMatch(){$('match-count').textContent=`Aciertos: ${matched.size} de 5`;$('match-vowels').replaceChildren();$('match-objects').replaceChildren();vowels.forEach(v=>{let b=document.createElement('button');b.type='button';b.className='choice'+(chosen===v?' selected':'');b.textContent=v;b.disabled=matched.has(v);b.addEventListener('click',()=>{chosen=v;$('match-feedback').textContent='Busca la imagen de '+v+'.';renderMatch()});$('match-vowels').append(b)});[{v:'I',name:'Iglú',emoji:'🏠'},{v:'U',name:'Uvas',emoji:'🍇'},{v:'A',name:'Abeja',emoji:'🐝'},{v:'O',name:'Oso',emoji:'🐻'},{v:'E',name:'Estrella',emoji:'⭐'}].forEach(item=>{let b=document.createElement('button');b.type='button';b.className='choice object-choice';b.textContent=item.emoji+' '+item.name;b.disabled=matched.has(item.v);b.addEventListener('click',()=>{if(!chosen){$('match-feedback').textContent='Primero elige una vocal.';return}if(chosen===item.v){matched.add(item.v);chosen=null;tone(780);$('match-feedback').textContent=matched.size===5?'¡Encontraste las cinco parejas!':`¡Sí! ${item.name} comienza con ${item.v}.`;renderMatch()}else{$('match-feedback').textContent='Esa imagen comienza con otra vocal. ¡Intenta otra vez!';tone(330)}});$('match-objects').append(b)})}
$('match-reset').addEventListener('click',()=>{chosen=null;matched.clear();$('match-feedback').textContent='';renderMatch()});
let slots=Array(5).fill(null),tile=null,orderSolved=false;
function renderOrder(){$('order-count').textContent=`Aciertos: ${orderSolved?1:0} de 1`;$('order-slots').replaceChildren();$('order-tiles').replaceChildren();slots.forEach((v,i)=>{let b=document.createElement('button');b.type='button';b.className='slot';b.textContent=v||'·';b.setAttribute('aria-label',`Casilla ${i+1}: ${v||'vacía'}`);b.addEventListener('click',()=>{if(orderSolved)return;if(v){slots[i]=null;$('order-feedback').textContent='Ficha devuelta.'}else if(tile){slots[i]=tile;tile=null;$('order-feedback').textContent='Ficha colocada.'}else{$('order-feedback').textContent='Elige una ficha primero.'}renderOrder()});$('order-slots').append(b)});['O','A','U','E','I'].forEach(v=>{let b=document.createElement('button');b.type='button';b.className='choice'+(tile===v?' selected':'');b.textContent=v;b.disabled=slots.includes(v)||orderSolved;b.addEventListener('click',()=>{tile=v;$('order-feedback').textContent='Toca una casilla para colocar '+v+'.';renderOrder()});$('order-tiles').append(b)})}
$('order-check').addEventListener('click',()=>{if(slots.some(x=>!x)){$('order-feedback').textContent='Todavía faltan vocales.';return}if(slots.join('')==='AEIOU'){orderSolved=true;tone(850);$('order-feedback').textContent='¡Excelente! Las vocales están en orden.';renderOrder()}else{tone(330);$('order-feedback').textContent='Casi. La primera vocal del cuento fue A.'}});
$('order-reset').addEventListener('click',()=>{slots=Array(5).fill(null);tile=null;orderSolved=false;$('order-feedback').textContent='';renderOrder()});
let quizIndex=0,quizScore=0,quizDone=false;const quizQuestions=[...document.querySelectorAll('.quiz-question')];
function renderQuiz(){$('quiz-count').textContent=`Aciertos: ${quizScore} de 4 · Pregunta ${Math.min(quizIndex+1,4)} de 4`;quizQuestions.forEach((q,i)=>q.hidden=i!==quizIndex);$('quiz-next').hidden=!quizDone||quizIndex>=4;if(quizIndex===4)$('quiz-feedback').textContent=`¡Terminaste! Acertaste ${quizScore} de 4.`}
quizQuestions.forEach(q=>q.querySelectorAll('button').forEach((b,i)=>b.addEventListener('click',()=>{if(quizDone)return;if(i===+q.dataset.answer){quizDone=true;quizScore++;b.classList.add('correct');q.querySelectorAll('button').forEach(x=>x.disabled=true);tone(780);$('quiz-feedback').textContent='¡Correcto! Lo recordaste muy bien.';renderQuiz();$('quiz-next').hidden=false}else{b.classList.add('wrong');tone(330);$('quiz-feedback').textContent='Buena idea. Mira los dibujos e inténtalo de nuevo.'}})));
$('quiz-next').addEventListener('click',()=>{quizIndex++;quizDone=false;$('quiz-feedback').textContent='';renderQuiz()});$('quiz-reset').addEventListener('click',()=>{quizIndex=0;quizScore=0;quizDone=false;$('quiz-feedback').textContent='';quizQuestions.forEach(q=>q.querySelectorAll('button').forEach(b=>{b.disabled=false;b.classList.remove('correct','wrong')}));renderQuiz()});
})();
</script>
 
</body></html>