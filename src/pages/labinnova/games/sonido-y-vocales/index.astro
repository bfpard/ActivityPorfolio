    <footer>
     <p data-template-id="footer-text" class="canva-text" style="color: rgb(23, 61, 57); font-weight: 400; font-style: normal; font-size: 18px;">Una historia para descubrir sonidos, imágenes y nuevas palabras. ✦</p>
    </footer>
