---
const activity = {
    title: "Informe de Resultados de Actividades",

    description:
        "Resumen consolidado de las actividades realizadas, los resultados obtenidos y las evidencias recopiladas durante el desarrollo de la actividad.",

    evidence: {
        image: {
            title: "Cartografía Social",
            description:
                "Registro visual de la actividad realizada durante la jornada.",
            src: "/ActivityPorfolio/images/cartografia.webp",
            alt: "Evidencia fotográfica de la actividad",
        },

        video: {
            title: "Resumen audiovisual",
            description:
                "Video descriptivo con el desarrollo y los principales momentos de la actividad.",

            // URL de inserción de YouTube
            youtubeUrl: "https://www.youtube-nocookie.com/embed/K7e_jwTc3R8?si=ZDsQEFqDIQ2QfzOb",
        },
    },
};

/**
 * Configuración de la tabla.
 *
 * La cantidad de columnas depende de `columns`.
 * La cantidad de filas depende de `rows`.
 */
const tableData = {
    columns: [
        "Actividad / Fase",
        "Responsable",
        "Período",
        "Meta alcanzada",
        "Estado",
    ],

    rows: [
        ["Actividad 1", "Responsable 1", "Enero 10", "100%", "Completado"],
        ["Actividad 2", "Responsable 2", "Enero 15", "92%", "En proceso"],
        ["Actividad 3", "Responsable 3", "Enero 18", "100%", "Completado"],
        ["Actividad 4", "Responsable 4", "Enero 22", "98%", "Completado"],
    ],
};
---

<div class="w-full px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="mx-auto max-w-7xl">
        <!-- ========================= -->
        <!-- TITLE -->
        <!-- ========================= -->

        <section class="mb-10">
            <h1
                class="max-w-3xl text-4xl font-bold tracking-tight text-[#0C2340] sm:text-5xl"
            >
                {activity.title}
            </h1>

            <p
                class="mt-3 max-w-4xl text-base leading-7 text-gray-600 sm:text-lg"
            >
                {activity.description}
            </p>
        </section>

        <!-- ========================= -->
        <!-- TABLE -->
        <!-- ========================= -->

        <section
            class="mb-12 overflow-x-auto rounded-xl border border-gray-100 bg-white shadow-sm"
        >
            <div class="min-w-[700px]">
                <table class="w-full border-collapse text-left">
                    <!-- Header -->
                    <thead>
                        <tr class="bg-[#F0F3FB]">
                            {
                                tableData.columns.map((column) => (
                                    <th
                                        scope="col"
                                        class="px-5 py-4 text-xs font-semibold uppercase tracking-wide text-[#27456F]"
                                    >
                                        {column}
                                    </th>
                                ))
                            }
                        </tr>
                    </thead>

                    <!-- Rows -->
                    <tbody class="divide-y divide-gray-100">
                        {
                            tableData.rows.map((row) => (
                                <tr class="transition-colors hover:bg-gray-50">
                                    {row.map((cell) => (
                                        <td class="px-5 py-4 text-sm text-gray-700">
                                            {cell}
                                        </td>
                                    ))}
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <!-- ========================= -->
        <!-- EVIDENCE -->
        <!-- ========================= -->

        <section>
            <div class="mb-6">
                <h2
                    class="text-2xl font-bold tracking-tight text-[#0C2340] sm:text-3xl"
                >
                    Evidencias de la actividad
                </h2>

                <p class="mt-2 text-sm leading-6 text-gray-600 sm:text-base">
                    Registro visual y audiovisual correspondiente al desarrollo
                    de la actividad.
                </p>
            </div>

            <!-- Evidence grid -->
            <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
                <!-- ========================= -->
                <!-- IMAGE -->
                <!-- ========================= -->

                <article
                    class="overflow-hidden rounded-xl border border-gray-100 bg-white p-5 shadow-sm"
                >
                    <div class="mb-4">
                        <h3 class="text-xl font-semibold text-[#0C2340]">
                            {activity.evidence.image.title}
                        </h3>

                        <p class="mt-1 text-sm leading-6 text-gray-600">
                            {activity.evidence.image.description}
                        </p>
                    </div>

                    <div class="overflow-hidden rounded-lg bg-gray-100">
                        <img
                            src={activity.evidence.image.src}
                            alt={activity.evidence.image.alt}
                            class="h-[25rem] w-full object-cover object-top"
                            loading="lazy"
                        />
                    </div>
                </article>

                <!-- ========================= -->
                <!-- YOUTUBE VIDEO -->
                <!-- ========================= -->

                <article
                    class="overflow-hidden rounded-xl border border-gray-100 bg-white p-5 shadow-sm"
                >
                    <div class="mb-4">
                        <h3 class="text-xl font-semibold text-[#0C2340]">
                            {activity.evidence.video.title}
                        </h3>

                        <p class="mt-1 text-sm leading-6 text-gray-600">
                            {activity.evidence.video.description}
                        </p>
                    </div>

                    <div class="h-[25rem] overflow-hidden rounded-lg bg-black">
                        <iframe
                            src={activity.evidence.video.youtubeUrl}
                            title={activity.evidence.video.title}
                            class="h-full w-full"
                            loading="lazy"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            allowfullscreen
                        >
                        </iframe>
                    </div>
                </article>
            </div>
        </section>
    </div>
</div>
