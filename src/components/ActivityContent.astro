---
interface EvidenceImage {
    title: string;
    description: string;
    src: string;
    alt: string;
}

interface GalleryImage {
    src: string;
    alt: string;
}

interface EvidenceGallery {
    title: string;
    description: string;
    /** N imágenes a maquetar dentro de la card. */
    images: GalleryImage[];
}

interface EvidenceText {
    title: string;
    description: string;
    /** Opcional: si existe, se renderiza como lista (ul/li) bajo la descripción. */
    steps?: string[];
}

interface VideoIframe {
    embedUrl: string;
    width?: number;
    height?: number;
    title?: string;
}

interface EvidenceVideo {
    title: string;
    description: string;
    /** URL de inserción de YouTube (escenario 1). */
    youtubeUrl?: string;
    /** Configuración de iframe genérico, p. ej. SharePoint/Stream (escenario 2). */
    iframe?: VideoIframe;
}

interface Activity {
    title: string;
    description: string;
    evidence: {
        socialCartography: EvidenceImage;
        groupCartography: EvidenceGallery;
        problematic: EvidenceText;
        video: EvidenceVideo;
    };
}

type TableCell = string | { label: string; href: string };

interface TableData {
    columns: string[];
    rows: TableCell[][];
}

interface Props {
    activity: Activity;
    /** Opcional: si no se pasa, no se renderiza la tabla (p. ej. Fase 3 sin diario de campo). */
    tableData?: TableData | null;
}

const { activity, tableData = null } = Astro.props;

const video = activity.evidence.video;
const videoSrc = video.youtubeUrl ?? video.iframe?.embedUrl;
---

<div class="w-full px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="mx-auto max-w-7xl">
        <!-- ========================= -->
        <!-- TITLE -->
        <!-- ========================= -->

        <section class="mb-10">
            <h1
                class="max-w-3xl text-4xl font-bold tracking-tight text-[#0C2340] sm:text-5xl"
            >
                {activity.title}
            </h1>

            <p
                class="mt-3 max-w-4xl text-base leading-7 text-gray-600 sm:text-lg"
            >
                {activity.description}
            </p>
        </section>

        <!-- ========================= -->
        <!-- TABLE (opcional) -->
        <!-- ========================= -->

        {
            tableData && tableData.rows.length > 0 && (
                <section class="mb-12 overflow-x-auto rounded-xl border border-gray-100 bg-white shadow-sm">
                    <div class="min-w-[700px]">
                        <table class="w-full border-collapse text-left">
                            {/* Header */}
                            <thead>
                                <tr class="bg-[#F0F3FB]">
                                    {tableData.columns.map((column) => (
                                        <th
                                            scope="col"
                                            class="px-5 py-4 text-xs font-semibold uppercase tracking-wide text-[#27456F]"
                                        >
                                            {column}
                                        </th>
                                    ))}
                                </tr>
                            </thead>

                            {/* Rows */}
                            <tbody class="divide-y divide-gray-100">
                                {tableData.rows.map((row) => (
                                    <tr class="transition-colors hover:bg-gray-50">
                                        {row.map((cell) => (
                                            <td class="px-5 py-4 text-sm text-gray-700">
                                                {typeof cell === "string" ? (
                                                    cell
                                                ) : (
                                                    <a
                                                        href={cell.href}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="font-medium text-blue-700 underline decoration-blue-300 underline-offset-2 hover:text-blue-900"
                                                    >
                                                        {cell.label}
                                                    </a>
                                                )}
                                            </td>
                                        ))}
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </section>
            )
        }

        <!-- ========================= -->
        <!-- EVIDENCE -->
        <!-- ========================= -->

        <section class="mb-12">
            <div class="mb-6">
                <h2
                    class="text-2xl font-bold tracking-tight text-[#0C2340] sm:text-3xl"
                >
                    Evidencias de la actividad
                </h2>

                <p class="mt-2 text-sm leading-6 text-gray-600 sm:text-base">
                    Registro visual y audiovisual correspondiente al desarrollo
                    de la actividad.
                </p>
            </div>

            <!-- Evidence grid -->
            <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
                <!-- ========================= -->
                <!-- IMAGE -->
                <!-- ========================= -->

                <article
                    class="overflow-hidden rounded-xl border border-gray-100 bg-white p-5 shadow-sm"
                >
                    <div class="mb-4">
                        <h3 class="text-xl font-semibold text-[#0C2340]">
                            {activity.evidence.groupCartography.title}
                        </h3>

                        <p class="mt-1 text-sm leading-6 text-gray-600">
                            {activity.evidence.groupCartography.description}
                        </p>
                    </div>

                    <div class="space-y-4">
                        {
                            activity.evidence.groupCartography.images.map(
                                (image) => (
                                    <div class="overflow-hidden rounded-lg bg-gray-100">
                                        <img
                                            src={image.src}
                                            alt={image.alt}
                                            class="w-full object-cover object-top"
                                            loading="lazy"
                                        />
                                    </div>
                                ),
                            )
                        }
                    </div>
                </article>

                <!-- ========================= -->
                <!-- PROBLEMATIC -->
                <!-- ========================= -->

                <article
                    class="overflow-hidden rounded-xl border border-gray-100 bg-white p-5 shadow-sm"
                >
                    <div class="mb-4">
                        <h3 class="text-xl font-semibold text-[#0C2340]">
                            {activity.evidence.problematic.title}
                        </h3>

                        <p class="mt-1 text-sm leading-6 text-gray-600">
                            {activity.evidence.problematic.description}
                        </p>

                        {
                            activity.evidence.problematic.steps &&
                                activity.evidence.problematic.steps.length > 0 && (
                                    <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-6 text-gray-600">
                                        {activity.evidence.problematic.steps.map(
                                            (step) => (
                                                <li>{step}</li>
                                            ),
                                        )}
                                    </ul>
                                )
                        }
                    </div>
                </article>
            </div>
        </section>

        <section>
            <!-- Evidence grid -->
            <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
                <!-- ========================= -->
                <!-- IMAGE -->
                <!-- ========================= -->

                <article
                    class="overflow-hidden rounded-xl border border-gray-100 bg-white p-5 shadow-sm"
                >
                    <div class="mb-4">
                        <h3 class="text-xl font-semibold text-[#0C2340]">
                            {activity.evidence.socialCartography.title}
                        </h3>

                        <p class="mt-1 text-sm leading-6 text-gray-600">
                            {activity.evidence.socialCartography.description}
                        </p>
                    </div>

                    <div class="overflow-hidden rounded-lg bg-gray-100">
                        <img
                            src={activity.evidence.socialCartography.src}
                            alt={activity.evidence.socialCartography.alt}
                            class="h-[25rem] w-full object-cover object-top"
                            loading="lazy"
                        />
                    </div>
                </article>

                <!-- ========================= -->
                <!-- VIDEO (YouTube o iframe genérico) -->
                <!-- ========================= -->

                <article
                    class="overflow-hidden rounded-xl border border-gray-100 bg-white p-5 shadow-sm"
                >
                    <div class="mb-4">
                        <h3 class="text-xl font-semibold text-[#0C2340]">
                            {video.title}
                        </h3>

                        <p class="mt-1 text-sm leading-6 text-gray-600">
                            {video.description}
                        </p>
                    </div>

                    <div class="h-[25rem] overflow-hidden rounded-lg bg-black">
                        {
                            videoSrc && (
                                <iframe
                                    src={videoSrc}
                                    title={video.iframe?.title ?? video.title}
                                    class="h-full w-full"
                                    loading="lazy"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                    allowfullscreen
                                />
                            )
                        }
                    </div>
                </article>
            </div>
        </section>
    </div>
</div>
