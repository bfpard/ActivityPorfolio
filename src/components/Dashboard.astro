
---
interface Props {
  title?: string;
}

const { title = "¡Vamos a dibujar!" } = Astro.props;
---

<section class="drawing-board">
  <header class="board-header">
    <div>
      <span class="eyebrow">MI ESPACIO CREATIVO</span>
      <h2>{title}</h2>
      <p>¡Dibuja, escribe las vocales y deja volar tu imaginación!</p>
    </div>
    <span class="board-decoration" aria-hidden="true">🎨</span>
  </header>

  <div class="toolbar" role="toolbar" aria-label="Herramientas de dibujo">
    <div class="tool-group">
      <button class="tool-button active" type="button" data-tool="pen" aria-pressed="true">
        ✏️ Lápiz
      </button>
      <button class="tool-button" type="button" data-tool="eraser" aria-pressed="false">
        🧽 Borrador
      </button>
    </div>

    <div class="color-group" aria-label="Colores">
      <span class="toolbar-label">Colores</span>
      <button class="color-button selected" type="button" data-color="#222222" aria-label="Negro" aria-pressed="true"></button>
      <button class="color-button" type="button" data-color="#ef4444" aria-label="Rojo" aria-pressed="false"></button>
      <button class="color-button" type="button" data-color="#f59e0b" aria-label="Amarillo" aria-pressed="false"></button>
      <button class="color-button" type="button" data-color="#22a06b" aria-label="Verde" aria-pressed="false"></button>
      <button class="color-button" type="button" data-color="#3b82f6" aria-label="Azul" aria-pressed="false"></button>
      <button class="color-button" type="button" data-color="#a855f7" aria-label="Morado" aria-pressed="false"></button>
      <button class="color-button" type="button" data-color="#ec4899" aria-label="Rosado" aria-pressed="false"></button>
    </div>

    <label class="size-control">
      <span class="toolbar-label">Grosor</span>
      <input data-brush-size type="range" min="2" max="24" value="5" />
    </label>

    <button class="clear-button" type="button" data-clear>🗑️ Limpiar</button>
  </div>

  <div class="canvas-wrap">
    <canvas data-canvas aria-label="Área para dibujar con el dedo o el ratón"></canvas>
    <span class="canvas-hint" data-hint>¡Empieza a dibujar aquí! ✨</span>
  </div>

  <footer class="board-footer">
    <span>🌈 ¡Cada dibujo es especial!</span>
    <button type="button" data-undo disabled>↶ Deshacer</button>
  </footer>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".drawing-board").forEach((board) => {
    if (board.dataset.ready) return;
    board.dataset.ready = "true";

    const canvas = board.querySelector<HTMLCanvasElement>("[data-canvas]")!;
    const ctx = canvas.getContext("2d")!;
    const hint = board.querySelector<HTMLElement>("[data-hint]")!;
    const undoButton = board.querySelector<HTMLButtonElement>("[data-undo]")!;
    const sizeInput = board.querySelector<HTMLInputElement>("[data-brush-size]")!;

    let color = "#222222";
    let tool = "pen";
    let size = 5;
    let drawing = false;
    let history: ImageData[] = [];

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      if (!rect.width || !rect.height) return;

      // Conserva el dibujo cuando cambia el tamaño del tablero.
      const previous = canvas.width
        ? ctx.getImageData(0, 0, canvas.width, canvas.height)
        : null;

      const dpr = window.devicePixelRatio || 1;
      canvas.width = Math.round(rect.width * dpr);
      canvas.height = Math.round(rect.height * dpr);

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.lineCap = "round";
      ctx.lineJoin = "round";
      ctx.fillStyle = "#ffffff";
      ctx.fillRect(0, 0, rect.width, rect.height);

      if (previous) {
        const temp = document.createElement("canvas");
        temp.width = previous.width;
        temp.height = previous.height;
        temp.getContext("2d")!.putImageData(previous, 0, 0);
        ctx.drawImage(temp, 0, 0, previous.width, previous.height, 0, 0, rect.width, rect.height);
      }
    };

    const save = () => {
      history.push(ctx.getImageData(0, 0, canvas.width, canvas.height));
      if (history.length > 20) history.shift();
      undoButton.disabled = false;
    };

    const point = (event: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      return { x: event.clientX - rect.left, y: event.clientY - rect.top };
    };

    canvas.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "mouse" && event.button !== 0) return;
      event.preventDefault();
      save();
      drawing = true;
      canvas.setPointerCapture(event.pointerId);

      const p = point(event);
      ctx.beginPath();
      ctx.moveTo(p.x, p.y);
      ctx.lineTo(p.x + 0.1, p.y + 0.1);
      ctx.strokeStyle = tool === "eraser" ? "#ffffff" : color;
      ctx.lineWidth = tool === "eraser" ? size * 4 : size;
      ctx.stroke();
      hint.hidden = true;
    });

    canvas.addEventListener("pointermove", (event) => {
      if (!drawing) return;
      event.preventDefault();

      const p = point(event);
      ctx.lineTo(p.x, p.y);
      ctx.strokeStyle = tool === "eraser" ? "#ffffff" : color;
      ctx.lineWidth = tool === "eraser" ? size * 4 : size;
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(p.x, p.y);
    });

    const stop = () => {
      drawing = false;
      ctx.beginPath();
    };

    canvas.addEventListener("pointerup", stop);
    canvas.addEventListener("pointercancel", stop);
    canvas.addEventListener("lostpointercapture", stop);

    board.querySelectorAll<HTMLButtonElement>("[data-tool]").forEach((button) => {
      button.addEventListener("click", () => {
        tool = button.dataset.tool!;
        board.querySelectorAll("[data-tool]").forEach((item) => {
          item.classList.toggle("active", item === button);
          item.setAttribute("aria-pressed", String(item === button));
        });
      });
    });

    board.querySelectorAll<HTMLButtonElement>("[data-color]").forEach((button) => {
      button.style.backgroundColor = button.dataset.color!;

      button.addEventListener("click", () => {
        color = button.dataset.color!;
        tool = "pen";

        board.querySelectorAll("[data-color]").forEach((item) => {
          item.classList.toggle("selected", item === button);
          item.setAttribute("aria-pressed", String(item === button));
        });

        board.querySelectorAll<HTMLButtonElement>("[data-tool]").forEach((item) => {
          const selected = item.dataset.tool === "pen";
          item.classList.toggle("active", selected);
          item.setAttribute("aria-pressed", String(selected));
        });
      });
    });

    sizeInput.addEventListener("input", () => {
      size = Number(sizeInput.value);
    });

    board.querySelector<HTMLButtonElement>("[data-clear]")!.addEventListener("click", () => {
      save();
      ctx.save();
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.fillStyle = "#ffffff";
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.restore();
      hint.hidden = false;
    });

    undoButton.addEventListener("click", () => {
      const previous = history.pop();
      if (!previous) return;

      ctx.putImageData(previous, 0, 0);
      undoButton.disabled = history.length === 0;
      hint.hidden = history.length > 0;
    });

    new ResizeObserver(resize).observe(canvas);
    resize();
  });
</script>

<style>
  .drawing-board {
    width: 100%;
    overflow: hidden;
    border: 2px solid #e2e8f0;
    border-radius: 24px;
    background: white;
    color: #26324b;
    box-shadow: 0 12px 30px rgb(31 41 55 / 8%);
    font-family: inherit;
  }

  .board-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1.1rem, 4vw, 2rem);
    background: linear-gradient(120deg, #eff6ff, #fdf2f8 60%, #fffbeb);
  }

  .eyebrow {
    color: #5266a6;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .board-header h2 {
    margin: 0.35rem 0;
    font-size: clamp(1.4rem, 4vw, 2rem);
    font-weight: 800;
  }

  .board-header p {
    margin: 0;
    color: #596579;
    line-height: 1.5;
  }

  .board-decoration {
    font-size: clamp(2.3rem, 7vw, 4rem);
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem;
    border-bottom: 1px solid #e7ebf2;
  }

  .tool-group, .color-group, .size-control {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .toolbar-label {
    color: #657086;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .tool-button, .clear-button, .board-footer button {
    min-height: 42px;
    border: 1px solid #dce3ed;
    border-radius: 12px;
    padding: 0.55rem 0.8rem;
    background: white;
    color: #344054;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
  }

  .tool-button.active {
    border-color: #5476d8;
    background: #edf2ff;
    color: #2d4eae;
  }

  .color-button {
    width: 29px;
    height: 29px;
    border: 3px solid white;
    border-radius: 50%;
    box-shadow: 0 0 0 1px #d5dce6;
    cursor: pointer;
  }

  .color-button.selected {
    box-shadow: 0 0 0 3px #637bd5;
  }

  .size-control input {
    width: 86px;
    accent-color: #5476d8;
  }

  .clear-button {
    margin-left: auto;
    border-color: #fecaca;
    background: #fff5f5;
    color: #b42318;
  }

  .canvas-wrap {
    position: relative;
    height: clamp(300px, 52vw, 490px);
    min-height: 280px;
    background: white;
  }

  [data-canvas] {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    cursor: crosshair;
    touch-action: none;
  }

  .canvas-hint {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 90%;
    color: #a3adbd;
    font-size: clamp(1rem, 3vw, 1.3rem);
    font-weight: 700;
    text-align: center;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .canvas-hint[hidden] {
    display: none;
  }

  .board-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.8rem 1rem;
    border-top: 1px solid #e7ebf2;
    color: #657086;
    font-size: 0.85rem;
  }

  .board-footer button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  @media (max-width: 600px) {
    .toolbar {
      gap: 0.7rem;
      padding: 0.8rem;
    }

    .tool-group, .color-group {
      width: 100%;
    }

    .tool-button {
      flex: 1;
    }

    .clear-button {
      margin-left: 0;
    }

    .canvas-wrap {
      height: 380px;
    }
  }
</style>
