---
const profile = {
  badge: 'UNAD • 2026',
  reference: 'Fusagasugá, Cundinamarca',
  name: 'Kimberly Daza',
  career: 'Docente',

  description: [
    'Mi nombre es Kimberly Daza Contreras, soy docente de primera infancia y estudiante universitaria en el área de educación.',

    'Me desempeño como profesora en preescolar y primaria, tengo 31 años y pertenezco a la zona ZCBC- CEAD Fusagasugá.',
  ],

  metrics: [
    {
      value: 'Amor',
      label: '',
      detail: '',
    },
    {
      value: '9.4',
      suffix: '/10',
      label: 'Promedio general',
    },
    {
      value: 'Ultima actualización',
      label: 'Maestros, infancias y contextos',
      detail: 'Papers',
    },
    {
      value: '●',
      label: 'Honores 2023',
      detail: 'Distinción al mérito',
    },
  ],

  image: '/images/photo.webp',

  card: {
    name: 'Kimberly Daza Contreras',
    semester: 'MAESTROS, INFANCIAS Y CONTEXTOS',
    university: 'Universidad Nacional Abierta y a Distancia',
    focus: 'Licenciatura en educación infantil',
    id: '502707683A_2204',
  },
};
---

<section
  id="about-me"
  class="w-full px-4 py-12 sm:px-6 lg:px-8 lg:py-20"
>
  <div
    class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16"
  >

    <!-- ========================= -->
    <!-- LEFT: INFORMATION -->
    <!-- ========================= -->

    <div class="flex flex-col justify-center">

      <!-- Header -->
      <div class="mb-6">

        <div class="mb-4 flex items-center gap-3">
          <span
            class="rounded-full bg-[#F1E4D5] px-3 py-1 text-[9px] font-semibold uppercase tracking-[0.15em] text-[#A64B2A]"
          >
            {profile.badge}
          </span>

          <span
            class="text-[9px] font-medium uppercase tracking-[0.12em] text-gray-500"
          >
            {profile.reference}
          </span>
        </div>

        <h1
          class="font-serif text-5xl leading-none tracking-tight text-gray-950 sm:text-6xl lg:text-7xl"
        >
          {profile.name}
        </h1>

        <p
          class="mt-3 font-serif text-sm italic text-[#A64B2A] sm:text-base"
        >
          {profile.career}
        </p>

      </div>


      <!-- Description -->
      <div class="max-w-2xl space-y-5 text-sm leading-7 text-gray-700 sm:text-base">

        {
          profile.description.map((paragraph, index) => (
            <p class={index === 0 ? 'first-letter:float-left first-letter:mr-2 first-letter:font-serif first-letter:text-5xl first-letter:leading-[0.8] first-letter:text-gray-950' : ''}>
              {paragraph}
            </p>
          ))
        }

      </div>


      <!-- Metrics -->
      <!-- <div
        class="mt-8 grid grid-cols-2 divide-x divide-gray-200 overflow-hidden rounded-lg bg-[#F1EEE7] sm:grid-cols-4"
      >

        {
          profile.metrics.map((metric) => (
            <div class="px-4 py-4">

              <div class="flex items-baseline gap-1">
                <span
                  class="font-serif text-2xl font-semibold leading-none text-gray-950"
                >
                  {metric.value}
                </span>

                {metric.suffix && (
                  <span class="text-xs text-gray-600">
                    {metric.suffix}
                  </span>
                )}
              </div>

              <p class="mt-2 text-[8px] font-semibold uppercase tracking-[0.12em] text-gray-700">
                {metric.label}
              </p>

              {metric.detail && (
                <p class="mt-0.5 text-[8px] uppercase tracking-[0.08em] text-gray-500">
                  {metric.detail}
                </p>
              )}

            </div>
          ))
        }

      </div> -->

    </div>


    <!-- ========================= -->
    <!-- RIGHT: PROFILE CARD -->
    <!-- ========================= -->

    <div class="flex justify-center lg:justify-end">

      <article
        class="w-full max-w-md overflow-hidden rounded-xl border border-white bg-white p-1.5 shadow-lg"
      >

        <!-- Image -->
        <div class="relative overflow-hidden rounded-lg">

          <img
            src={profile.image}
            alt={`Fotografía de ${profile.name}`}
            class="w-full h-[37.5rem] object-cover object-top"
          />

          <!-- Card badge -->
          <span
            class="absolute right-0 top-0 rounded-bl-lg bg-gray-950 px-3 py-1 text-[8px] font-semibold uppercase tracking-[0.12em] text-white"
          >
            Kim
          </span>

        </div>


        <!-- Card information -->
        <div class="px-2 pb-3 pt-3">

          <div class="flex items-start justify-between gap-4">

            <h2 class="font-serif text-sm font-semibold text-gray-950">
              {profile.card.name}
            </h2>

            <span
              class="whitespace-nowrap text-[8px] font-medium uppercase tracking-[0.1em] text-[#A64B2A]"
            >
              {profile.card.semester}
            </span>

          </div>


          <p class="mt-1 text-[9px] leading-4 text-gray-600">
            {profile.card.university}
          </p>


          <div
            class="mt-4 flex items-center justify-between border-t border-gray-100 pt-2"
          >

            <span
              class="text-[8px] font-medium uppercase tracking-[0.1em] text-[#A64B2A]"
            >
              {profile.card.focus}
            </span>

            <span
              class="text-[8px] tracking-[0.08em] text-gray-500"
            >
              {profile.card.id}
            </span>

          </div>

        </div>

      </article>

    </div>

  </div>
</section>
